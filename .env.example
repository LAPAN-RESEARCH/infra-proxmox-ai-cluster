# Copy to configs/ai-stack/.env or /srv/ai/compose/core/.env and replace every value.
TZ=America/Sao_Paulo

# Image tags. Pin exact tags or digests after first validation.
OLLAMA_TAG=latest
OPEN_WEBUI_TAG=main
QDRANT_TAG=latest
NEO4J_TAG=2026.04.0
JUPYTER_BASE_TAG=2026-05-11
UV_VERSION=latest
SPEACHES_TAG=latest-cuda
SPEACHES_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo

# RAG (ai-api / jupyter).
RAG_COLLECTION=research_chunks_bge_m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Ollama runtime (VRAM budgeting; see docs/06-operations/04-capacity-planning.md).
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# ai-api gateway.
AI_API_PORT=8088
AI_API_ALLOW_LOCAL_HEALTHZ=true

# WhisperLiveKit (realtime consultation transcription with diarization).
WLK_PORT=8010
WLK_MODEL=large-v3-turbo
WLK_MAX_SPEAKERS=2

# Escuta clínica (two-click consultation app; see docs/tutorials/12-escuta-clinica-app.md).
ESCUTA_PORT=8020
ESCUTA_EXTRAS=gpu
ESCUTA_RETENTION_DAYS=90
ESCUTA_ASR_BACKEND=http
ESCUTA_SOAP_MODEL=qwen3:8b
ESCUTA_LAUDO_MODEL=qwen3:8b
ESCUTA_VERIFY_MODEL=qwen3:8b
ESCUTA_OLLAMA_MODEL=gpt-oss:20b
ESCUTA_UNLOAD_TITULAR_ON_JOB=0
ESCUTA_API_TOKEN=${REPLACE_WITH_RANDOM_HEX_OR_EMPTY_FOR_DISABLED}

# Secrets. Replace with random values; never commit real secrets.
WEBUI_SECRET_KEY=${REPLACE_WITH_RANDOM_HEX}
QDRANT_API_KEY=${REPLACE_WITH_RANDOM_HEX}
NEO4J_AUTH=neo4j/${REPLACE_WITH_STRONG_PASSWORD}
JUPYTER_TOKEN=${REPLACE_WITH_RANDOM_TOKEN}
SPEACHES_API_KEY=${REPLACE_WITH_RANDOM_HEX}
AI_API_KEY=${REPLACE_WITH_RANDOM_HEX}
WLK_API_TOKEN=${REPLACE_WITH_RANDOM_HEX}
