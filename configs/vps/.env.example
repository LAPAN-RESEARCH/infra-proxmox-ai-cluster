# Copy to configs/vps/.env on the VPS and replace every value.
TZ=America/Sao_Paulo

# Public domain pointed at the VPS (A record). Hosts used: api.DOMAIN, n8n.DOMAIN.
DOMAIN=example.com

# Existing Traefik on the VPS.
TRAEFIK_NETWORK=traefik-proxy
TRAEFIK_ENTRYPOINT=websecure

# Image tags (pin after first validation).
LITELLM_TAG=main-stable
N8N_TAG=latest

# Hospital upstream (ai-api). LAPAN_AI_API_KEY is the AI_API_KEY value from
# /srv/ai/compose/core/.env on lapan-ai.
LAPAN_AI_API_KEY=${REPLACE_WITH_AI_API_KEY_FROM_HOSPITAL}
LAPAN_AI_BASE_URL=https://lapan-ai.tailf9eac9.ts.net/v1

# Secrets. Replace with: "sk-$(openssl rand -hex 24)" / "$(openssl rand -hex 24)".
POSTGRES_PASSWORD=${REPLACE_WITH_RANDOM_PASSWORD}
LITELLM_MASTER_KEY=sk-${REPLACE_WITH_RANDOM_HEX}
LITELLM_SALT_KEY=${REPLACE_WITH_RANDOM_HEX}
N8N_ENCRYPTION_KEY=${REPLACE_WITH_RANDOM_HEX}
