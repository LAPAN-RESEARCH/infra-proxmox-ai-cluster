{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "enabled": true
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "trustedProxies": [
      "192.168.65.0/24",
      "172.17.0.0/16",
      "127.0.0.1"
    ]
  },
  "models": {
    "providers": {
      "google": {
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "GEMINI_API_KEY"
        },
        "api": "google-generative-ai",
        "models": [
          {
            "id": "gemini-2.5-pro",
            "name": "Gemini 2.5 Pro (1M Context)"
          },
          {
            "id": "gemini-2.5-flash",
            "name": "Gemini 2.5 Flash (Rápido)"
          }
        ]
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "OPENROUTER_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "meta-llama/llama-3.3-70b-instruct:free",
            "name": "Llama 3.3 70B Free"
          },
          {
            "id": "qwen/qwen-2.5-72b-instruct:free",
            "name": "Qwen 2.5 72B Free"
          }
        ]
      },
      "ollama": {
        "baseUrl": "http://ollama:11434/v1",
        "apiKey": "ollama-local",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3:8b",
            "name": "Qwen3 8B (Agente & Tool Calling)"
          },
          {
            "id": "gpt-oss:20b",
            "name": "GPT-OSS 20B"
          },
          {
            "id": "qwen2.5-coder:7b",
            "name": "Qwen 2.5 Coder 7B"
          },
          {
            "id": "gemma4:latest",
            "name": "Gemma 4"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-pro",
        "fallbacks": [
          "openrouter/meta-llama/llama-3.3-70b-instruct:free",
          "ollama/qwen3:8b"
        ]
      },
      "subagents": {
        "model": "google/gemini-2.5-flash"
      },
      "workspace": "/home/node/workspace"
    }
  },
  "mcp": {
    "servers": {
      "papers": {
        "command": "paper-search-mcp",
        "env": {
          "PAPER_SEARCH_MCP_UNPAYWALL_EMAIL": "hugodepaula@gmail.com"
        }
      },
      "zotero": {
        "command": "zotero-mcp",
        "env": {
          "ZOTERO_LOCAL": "true",
          "ZOTERO_DB_PATH": "/home/node/Zotero/zotero.sqlite",
          "ZOTERO_EMBEDDING_MODEL": "ollama",
          "OLLAMA_BASE_URL": "http://ollama:11434",
          "OLLAMA_EMBEDDING_MODEL": "bge-m3"
        }
      },
      "arxiv": {
        "command": "arxiv-mcp-server",
        "args": ["--storage-path", "/home/node/workspace/arxiv-papers"]
      },
      "biomcp": {
        "command": "biomcp",
        "args": ["serve"]
      },
      "github": {
        "command": "mcp-github"
      },
      "qdrant": {
        "command": "mcp-qdrant"
      },
      "neo4j": {
        "command": "mcp-neo4j"
      },
      "semanticscholar": {
        "command": "mcp-semanticscholar"
      },
      "serena": {
        "command": "serena",
        "args": ["start-mcp-server", "--context", "agent"]
      }
      }
    }
  },
  "plugins": {
    "slots": {
      "memory": "memory-lancedb"
    },
    "entries": {
      "memory-lancedb": {
        "enabled": true,
        "config": {
          "embedding": {
            "provider": "ollama",
            "baseUrl": "http://ollama:11434",
            "model": "bge-m3",
            "dimensions": 1024
          },
          "autoRecall": true,
          "autoCapture": true
        }
      },
      "searxng": {
        "enabled": true,
        "config": {
          "webSearch": {
            "baseUrl": "http://searxng:8080",
            "language": "pt-BR"
          }
        }
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["/opt/openclaw-skills"]
    }
  },
  "tools": {
    "toolSearch": true,
    "web": {
      "search": {
        "provider": "searxng"
      }
    },
    "exec": {
      "security": "full",
      "ask": "off"
    }
  },
  "browser": {
    "enabled": true,
    "headless": true
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.9.9"
  }
}