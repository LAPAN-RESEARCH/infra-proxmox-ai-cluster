# Copy to configs/ai-stack/.env or /srv/ai/compose/core/.env and replace every value.
TZ=America/Sao_Paulo

# Image tags. Pin exact tags or digests after first validation.
OLLAMA_TAG=latest
OPEN_WEBUI_TAG=main
QDRANT_TAG=latest
NEO4J_TAG=2026.04.0
JUPYTER_BASE_TAG=2026-05-11
UV_VERSION=latest
SPEACHES_TAG=latest-cuda
SPEACHES_MODEL=Systran/faster-distil-whisper-large-v3
RAG_COLLECTION=research_chunks_bge_m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# OpenClaw
OPENCLAW_PORT=18789
OPENCLAW_AUTH_TOKEN=${REPLACE_WITH_RANDOM_HEX_OR_TOKEN}
# PAT fine-grained opcional para o GitHub MCP e gh CLI (escopos: contents/issues/
# pull_requests/actions da org LAPAN-RESEARCH). Vazio = usa o oauth_token do
# hosts.yml do gh do host (GH_CONFIG_DIR no compose).
GITHUB_PERSONAL_ACCESS_TOKEN=

# Secrets. Replace with random values; never commit real secrets.
WEBUI_SECRET_KEY=${REPLACE_WITH_RANDOM_HEX}
QDRANT_API_KEY=${REPLACE_WITH_RANDOM_HEX}
NEO4J_AUTH=neo4j/${REPLACE_WITH_STRONG_PASSWORD}
JUPYTER_TOKEN=${REPLACE_WITH_RANDOM_TOKEN}
SPEACHES_API_KEY=${REPLACE_WITH_RANDOM_HEX}
GEMINI_API_KEY=${REPLACE_WITH_GOOGLE_AI_STUDIO_KEY}
OPENROUTER_API_KEY=${REPLACE_WITH_OPENROUTER_KEY}
# Chave opcional da API do Semantic Scholar (para limites de taxa maiores no MCP semanticscholar)
SEMANTIC_SCHOLAR_API_KEY=
# Chaves acadêmicas opcionais (limites de taxa maiores; serviços públicos)
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_MCP_OPENALEX_API_KEY=
NCBI_API_KEY=
# Token do bot Telegram (BotFather) — ativa o canal quando channels.telegram
# for configurado no openclaw.json (ver docs/08-openclaw/03-plugins-e-skills.md)
TELEGRAM_BOT_TOKEN=

